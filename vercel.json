{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"trailingSlash": false,
	"rewrites": [
		{
			"source": "/zeroagent/download/:arch(arm64|x64)",
			"destination": "/api/download?arch=:arch"
		}
	],
	"redirects": [
		{
			"source": "/zeroagent",
			"destination": "https://zeroagenthq.com/",
			"permanent": true
		},
		{
			"source": "/zeroagent/download",
			"destination": "https://zeroagenthq.com/download",
			"permanent": true
		},
		{
			"source": "/zeroagent/terms",
			"destination": "https://zeroagenthq.com/terms",
			"permanent": true
		},
		{
			"source": "/zeroagent/privacy",
			"destination": "https://zeroagenthq.com/privacy",
			"permanent": true
		},
		{
			"source": "/zeroagent/stats",
			"destination": "https://zeroagenthq.com/stats",
			"permanent": true
		}
	]
}
